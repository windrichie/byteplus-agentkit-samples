# --- Dispatcher agent model (BytePlus ModelArk) ---
MODEL_NAME=deepseek-v3-2-251201
MODEL_AGENT_API_BASE=https://ark.ap-southeast.bytepluses.com/api/v3/
MODEL_AGENT_API_KEY=

# --- AgentKit sandbox (CodeEnv with codex runtime) ---
# Create once, out of band (the model key is baked into the tool at creation —
# the agent never sees it):
#   agentkit --provider byteplus sandbox create --tool-type CodeEnv \
#     --tool-name codex-one-shot --cpu 2 --model-api-key <your-model-key>
SANDBOX_TOOL_ID=
SANDBOX_SESSION_ID=agent

# Optional tuning
# CODEX_TIMEOUT_S=900          # per-codex-run timeout inside the sandbox
# OUTPUT_DIR=./output          # where download_project puts finished projects
# AGENTKIT_PROVIDER=byteplus   # passed to every agentkit CLI call
AGENTKIT_CLI=/absolute/path/to/agentkit   # if the Python agentkit SDK CLI
#                              # shadows the Go CLI under pyenv/uv
# SANDBOX_BACKEND=sdk          # sdk = no agentkit CLI needed (runtime deploys);
#                              # credentials then come from BYTEPLUS_ACCESS_KEY /
#                              # BYTEPLUS_SECRET_KEY env vars instead

# --- optional: cloud file delivery (AgentKit Runtime deploys) ---
# When TOS_BUCKET is set, download_project uploads the tarball to TOS and the
# agent reports a presigned download URL instead of (only) a local path.
# Local runs can leave these unset. Bucket below = platform-managed bucket
# (the one `agentkit deploy build` auto-ensures); any bucket you own works.
#TOS_BUCKET=agentkit-platform-3000087550
#TOS_REGION=ap-southeast-1
#TOS_ENDPOINT=tos-ap-southeast-1.bytepluses.com   # derived from TOS_REGION if unset
#TOS_KEY_PREFIX=codex-factory/
#TOS_URL_EXPIRES_S=86400
