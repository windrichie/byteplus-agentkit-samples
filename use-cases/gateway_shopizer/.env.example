# Copy to .env.local and fill in. .env.local is git-ignored — never commit keys.

# ---- Model (via AgentKit Model Gateway) ----
MODEL_NAME=deepseek-v4-flash-ga-260731
MODEL_GATEWAY_BASE_URL=https://<your-model-gateway>.apigateway-cn-beijing.volceapi.com/ark
MODEL_GATEWAY_API_KEY=<model-gateway-proxy-key>

# ---- Tools (via AgentKit MCP Gateway) ----
# Streamable HTTP URL of the MCP service created from swagger/shopizer-gateway-flat.json
MCP_GATEWAY_URL=https://<your-mcp-service>.apigateway-cn-beijing.volceapi.com/mcp
MCP_GATEWAY_API_KEY=<mcp-service-inbound-api-key>

# ---- Legacy app edge (nginx API-key gate in front of Shopizer) ----
LEGACY_APP_BASE_URL=http://<your-legacy-app-host>:8080
LEGACY_APP_API_KEY=<static-x-api-key-the-nginx-gate-expects>
