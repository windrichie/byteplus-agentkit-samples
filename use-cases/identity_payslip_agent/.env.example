# --- BytePlus account (signs Identity management calls + CheckPermission) ---
BYTEPLUS_ACCESS_KEY=
BYTEPLUS_SECRET_KEY=
BYTEPLUS_REGION=ap-southeast-1

# --- Agent model (BytePlus ModelArk) ---
MODEL_NAME=deepseek-v4-pro-ga-260813
MODEL_AGENT_API_BASE=https://ark.ap-southeast.bytepluses.com/api/v3/
MODEL_AGENT_API_KEY=

# --- Agent Identity (filled in by setup_identity.py -> .env.identity) ---
# Listed here for a purely manual setup; normally you don't edit these.
# PERMISSION_NAMESPACE=payslip-hw
# IDENTITY_DISCOVERY_URL=https://userpool-<pool-uid>.userpool.auth.id.ap-southeast-1.bytepluses.com/.well-known/openid-configuration
# IDENTITY_ALLOWED_CLIENTS=<client-id-1>,<shortlived-client-id-2>

# --- demo target (demo.py) ---
# AGENT_BASE_URL=http://127.0.0.1:8000          # local
# AGENT_BASE_URL=https://<runtime-apigw-url>     # deployed
